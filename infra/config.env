# B3-1 공통 설정 — 모든 스크립트와 문서는 이 이름/값을 기준으로 한다.
REGION=ap-northeast-2
AZ=ap-northeast-2a
PROJECT_TAG=B3-1
NAME_PREFIX=b3-1
VPC_CIDR=10.0.0.0/16
SUBNET_CIDR=10.0.1.0/24
INSTANCE_TYPE=t3.micro
VOLUME_SIZE_GB=8
KEY_NAME=b3-1-key
KEY_PATH="$HOME/.ssh/b3-1-key.pem"
# Amazon Linux 2023 최신 AMI (SSM 퍼블릭 파라미터로 조회)
AMI_SSM_PARAM=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64
# provision.sh 가 만든 리소스 ID를 기록하는 파일 (cleanup.sh가 읽음)
STATE_FILE=.b3-1-state

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDescribeInSeoul",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetConsoleOutput"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" } }
    },
    {
      "Sid": "CreateOnlyWithProjectTag",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateKeyPair",
        "ec2:ImportKeyPair",
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:*:vpc/*",
        "arn:aws:ec2:ap-northeast-2:*:subnet/*",
        "arn:aws:ec2:ap-northeast-2:*:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:*:route-table/*",
        "arn:aws:ec2:ap-northeast-2:*:security-group/*",
        "arn:aws:ec2:ap-northeast-2:*:key-pair/*",
        "arn:aws:ec2:ap-northeast-2:*:instance/*",
        "arn:aws:ec2:ap-northeast-2:*:volume/*"
      ],
      "Condition": { "StringEquals": { "aws:RequestTag/Project": "B3-1" } }
    },
    {
      "Sid": "TagOnlyAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:RequestTag/Project": "B3-1",
          "ec2:CreateAction": [
            "CreateVpc", "CreateSubnet", "CreateInternetGateway", "CreateRouteTable",
            "CreateSecurityGroup", "CreateKeyPair", "ImportKeyPair", "RunInstances"
          ]
        }
      }
    },
    {
      "Sid": "UseAndDeleteOnlyProjectTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup", "ec2:RunInstances",
        "ec2:ModifyVpcAttribute", "ec2:ModifySubnetAttribute",
        "ec2:AttachInternetGateway", "ec2:DetachInternetGateway",
        "ec2:CreateRoute", "ec2:DeleteRoute",
        "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable",
        "ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupEgress",
        "ec2:StartInstances", "ec2:StopInstances", "ec2:RebootInstances", "ec2:TerminateInstances",
        "ec2:DeleteVpc", "ec2:DeleteSubnet", "ec2:DeleteInternetGateway", "ec2:DeleteRouteTable",
        "ec2:DeleteSecurityGroup", "ec2:DeleteKeyPair", "ec2:DeleteVolume",
        "ec2:ReleaseAddress", "ec2:DisassociateAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "ec2:ResourceTag/Project": "B3-1"
        }
      }
    },
    {
      "Sid": "UntaggableSubResources",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2::image/*",
        "arn:aws:ec2:ap-northeast-2:*:network-interface/*",
        "arn:aws:ec2:ap-northeast-2:*:security-group-rule/*"
      ]
    },
    {
      "Sid": "OnlyMicroInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": { "StringNotEquals": { "ec2:InstanceType": ["t2.micro", "t3.micro"] } }
    },
    {
      "Sid": "ReadAmiParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:ap-northeast-2::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "DecodeAuthErrorsForTroubleshooting",
      "Effect": "Allow",
      "Action": ["sts:DecodeAuthorizationMessage", "sts:GetCallerIdentity"],
      "Resource": "*"
    }
  ]
}
